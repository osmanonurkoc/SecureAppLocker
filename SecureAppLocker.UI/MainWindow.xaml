<Window
    x:Class="SecureAppLocker.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windows Security">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Main Content Area -->
		<StackPanel Grid.Row="0" Margin="24,24,24,0" Spacing="16">
			<TextBlock Text="First, verify the master password." 
                       Style="{ThemeResource TitleTextBlockStyle}" 
                       FontSize="20" FontWeight="SemiBold"/>

			<Grid Margin="0,12,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Icon Placeholder -->
				<Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" 
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                        Margin="0,0,16,0">
					<Grid>
						<FontIcon x:Name="DefaultLockIcon" Glyph="&#xE72E;" FontSize="32" Visibility="Visible"/>
						<Image x:Name="AppIconImage" Width="48" Height="48" Stretch="Uniform" Visibility="Collapsed"/>
					</Grid>
				</Border>

				<!-- Inputs -->
				<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
					<TextBlock x:Name="AppPathText" Text="SecureAppLocker\target.exe" 
                               Style="{ThemeResource BodyTextBlockStyle}"/>
					<TextBlock Text="Password" 
                               Style="{ThemeResource CaptionTextBlockStyle}"/>
					<PasswordBox x:Name="PasswordInput" 
                                 PlaceholderText="Enter master password" 
                                 KeyDown="PasswordInput_KeyDown"/>
				</StackPanel>
			</Grid>
		</StackPanel>

		<!-- Bottom Action Bar -->
		<Border Grid.Row="1" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" 
                Padding="24,16">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Button x:Name="SubmitButton" Content="OK" Style="{ThemeResource AccentButtonStyle}" 
                        HorizontalAlignment="Stretch" Margin="0,0,4,0" Click="SubmitButton_Click"/>

				<Button x:Name="CancelButton" Content="Cancel" 
                        HorizontalAlignment="Stretch" Grid.Column="1" Margin="4,0,0,0" Click="CancelButton_Click"/>
			</Grid>
		</Border>
	</Grid>
</Window>